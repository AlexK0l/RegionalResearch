PORT=10000
NODE_ENV=development
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=128000
OPENAI_TARGETED_SEARCH_MAX_OUTPUT_TOKENS=3000
OPENAI_CONTACT_MAX_OUTPUT_TOKENS=1800
# Simultaneous full studies on one backend; default 2, allowed 1-10.
# A high setting can exhaust OpenAI RPM/TPM and local CPU/RAM.
# OPENAI_MAX_RESEARCH_COST_USD is per study; it is NOT a global cost cap.
MAX_ACTIVE_FULL_JOBS=2
# Automatic memory admission and checkpoint-based suspension. MiB.
# Conservative initial estimate; tune against measured real-job peaks.
RESEARCH_MEMORY_GUARD_ENABLED=true
RESEARCH_MEMORY_RESERVE_MIB=384
RESEARCH_MEMORY_JOB_MIB=1536
# Additional RAM before opening Saby Chromium, beyond the running job.
# On small hosts other studies pause at durable checkpoints until Saby closes.
RESEARCH_MEMORY_SABY_BROWSER_MIB=640
RESEARCH_MEMORY_SABY_RESUME_MARGIN_MIB=192
RESEARCH_MEMORY_HEAP_RESERVE_MIB=256
RESEARCH_MEMORY_HEAP_JOB_MIB=256
RESEARCH_MEMORY_POLL_MS=2000
RESEARCH_MEMORY_RESUME_STABLE_MS=15000
RESEARCH_MEMORY_START_SPACING_MS=5000
# Optional only under a supervised Linux systemd unit with Restart=on-failure.
# Restart exclusively after all waiting/paused jobs are confirmed in SQLite.
RESEARCH_MEMORY_IDLE_RECYCLE_ENABLED=false
RESEARCH_MEMORY_IDLE_RECYCLE_STALL_MS=120000
RESEARCH_MEMORY_IDLE_RECYCLE_COOLDOWN_MS=1800000
RESEARCH_MEMORY_IDLE_RECYCLE_MIN_RSS_MIB=384
OPENAI_FINAL_BATCH_SIZE=30
OPENAI_FINAL_BATCH_MIN_SPLIT_SIZE=5
OPENAI_FINAL_CONFLICT_GROUP_BATCH_SIZE=12
OPENAI_IDENTITY_MAX_OUTPUT_TOKENS=1800
OPENAI_FINAL_INN_BATCH_SIZE=5
OPENAI_FINAL_INN_CONCURRENCY=4
OPENAI_FINAL_INN_MAX_OUTPUT_TOKENS=2500
OPENAI_ENRICHMENT_CONCURRENCY=8
OPENAI_ENRICHMENT_SEARCH_TIMEOUT_MS=20000
OPENAI_CONTACT_CONCURRENCY=8
OPENAI_CONTACT_SEARCH_TIMEOUT_MS=18000
OPENAI_GOOGLE_FALLBACK_CONCURRENCY=2
OPENAI_CENSUS_ENABLED=true
OPENAI_CENSUS_BUCKET_MIN=12
OPENAI_COVERAGE_GAP_MAX=4
INCLUDE_PUBLIC_OPERATORS=true
STAGE10_MAX_MS=1680000
STAGE11_MAX_MS=1680000
CHECKPOINT_FLUSH_EVERY=10
CHECKPOINT_FLUSH_INTERVAL_MS=10000
COMPUTER_MODEL=gpt-5.6-luna
COMPUTER_FALLBACK_MODEL=gpt-5.6-sol
GOOGLE_AI_MAX_TURNS=2
GOOGLE_AI_AUTO_FALLBACK=false
GOOGLE_AI_COMPANY_TIMEOUT_MS=30000
GOOGLE_AI_VIEWPORT_WIDTH=1024
GOOGLE_AI_VIEWPORT_HEIGHT=768
GOOGLE_AI_SCREENSHOT_DETAIL=low
FINAL_BATCH_MODEL=gpt-5.6-luna
TARGETED_SEARCH_MODEL=gpt-5.6-luna
FINAL_QA_MODEL=gpt-5.6-luna
CONFLICT_MODEL=gpt-5.6-sol
GOOGLE_AI_SOL_RETRY_PRIORITY_AB=false
OPENAI_RESEARCH_MAX_RECOVERY_BRANCHES=1
OPENAI_RESEARCH_GEO_GROUPS=3

# Local persistent storage. Directories are created automatically.
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
LOG_DIR=./logs
PIPELINE_VERSION=1

OPENAI_WEB_SEARCH_COST_PER_CALL=0.01

# Optional when local backend is exposed beyond your own computer
# Without this token, local server listens on localhost only.
# To enable LAN access, set API_ACCESS_TOKEN and BIND_HOST=0.0.0.0 explicitly.
API_ACCESS_TOKEN=
BIND_HOST=127.0.0.1
# Max web_search tool calls for a full or resumed research run
OPENAI_FULL_WEB_MAX_CALLS=1850
OPENAI_MAX_RESEARCH_COST_USD=25
OPENAI_ESTIMATE_INPUT_USD_PER_M=0.2
OPENAI_ESTIMATE_CACHED_USD_PER_M=0.02
OPENAI_ESTIMATE_OUTPUT_USD_PER_M=1.2
OPENAI_ENRICHMENT_BATCH_SIZE=4
GOOGLE_AI_FALLBACK_ENABLED=false
# Autonomous studies never inherit old phones, even if this legacy flag is true.
# The legacy cache may be enabled ONLY with OPENAI_AUTONOMOUS_DISCOVERY_ENABLED=false.
OPENAI_PREVIOUS_CONTACT_CACHE=false
OPENAI_AUTONOMOUS_DISCOVERY_ENABLED=true
OPENAI_AUTONOMOUS_DISCOVERY_MAX_PASSES=2
OPENAI_AUTONOMOUS_DISCOVERY_MAX_TOOL_CALLS=2
# Historical candidates are read from up to 12 completed regional studies (max 20).
# Only 3x8 candidates may receive NEW paid searches; the rest remain in offline QA.
# Calls remain within EXISTING discovery/total limits; no historical INN/phone is copied.
OPENAI_HISTORICAL_RECALL_HISTORY_RUNS=12
# Only available in explicitly selected legacy mode; never active together with autonomous.
OPENAI_HISTORICAL_RECALL_ENABLED=false
OPENAI_HISTORICAL_RECALL_MAX_BATCHES=3
OPENAI_HISTORICAL_RECALL_BATCH_SIZE=8

# Evidence-first cost controls (local .env; values apply on the next run)
OPENAI_ENRICHMENT_BATCH_MAX_TOOL_CALLS=1
OPENAI_ENRICHMENT_MAX_FALLBACKS_TOTAL=20
OPENAI_ENRICHMENT_MAX_FALLBACKS_PER_BATCH=1


# Local research limits (full/resume). These are independently enforced ceilings
# Reserve up to 75 web calls and $1.20 estimated cost for contacts FROM OPTIONAL
# enrichment only. No additional tool calls are granted. Set 0 to disable.
OPENAI_CONTACTS_PROTECTED_WEB_CALLS=145
OPENAI_CONTACTS_PROTECTED_ESTIMATED_USD=1.2
# Second pass only for missing/invalid *batch contact responses* (not valid
# source-backed "not_found"). Default 8 batches x 3 firms, remaining budget only.
# Setting batches to 0 disables all extra calls. Contact+total budget unchanged.
OPENAI_CONTACT_OMISSION_RECHECK_BATCHES=8
OPENAI_CONTACT_OMISSION_RECHECK_BATCH_SIZE=3
# within OPENAI_FULL_WEB_MAX_CALLS, not an additive quota.
OPENAI_FULL_WEB_DISCOVERY_MAX_CALLS=1050
OPENAI_FULL_WEB_IDENTITY_MAX_CALLS=600
OPENAI_FULL_WEB_ENRICHMENT_MAX_CALLS=120
OPENAI_FULL_WEB_CONTACTS_MAX_CALLS=340
OPENAI_FULL_WEB_STATISTICS_MAX_CALLS=12
OPENAI_FULL_WEB_OTHER_MAX_CALLS=70

# Contact batching and strictly bounded retries
OPENAI_CONTACT_BATCH_ENABLED=true
OPENAI_CONTACT_BATCH_SIZE=5
OPENAI_CONTACT_BATCH_MAX_TOOL_CALLS=2
OPENAI_CONTACT_INDIVIDUAL_FALLBACKS=30
OPENAI_CONTACT_PHONE_RETRIES=12

# Lightweight direct public source collection, exact INN + legal name.
# Explicit opt-in for production; no paid API and no browser for HTML.
PUBLIC_CONTACTS_ENABLED=false
PUBLIC_CONTACTS_MAX_COMPANIES=350
PUBLIC_CONTACTS_MAX_REQUESTS=750
PUBLIC_CONTACTS_MAX_MS=720000
PUBLIC_CONTACTS_CHECKPOINT_EVERY=5
# Optional official EGRUL PDF contact pass after Saby; requires Chromium
# and pdftotext. Keep off on a small VPS until the source is smoke-tested.
PUBLIC_CONTACTS_FNS_ENABLED=false
PUBLIC_CONTACTS_FNS_MAX_COMPANIES=25
PUBLIC_CONTACTS_FNS_MAX_MS=900000

# IMPORTANT: This template does not overwrite your existing .env file.
# Update the real local .env manually and avoid duplicate variable names.
# The $25 is an *estimated* cost cap, not a confirmed OpenAI billing hard cap.

# Verified A/B gap recovery: deliberately bounded and charged against the
# SAME research $25 / 1850 web calls and 190 enrichment calls (not extra).
OPENAI_AB_RECOVERY_ENABLED=true
OPENAI_AB_RECOVERY_BATCH_SIZE=3
OPENAI_AB_RECOVERY_MAX_BATCHES=20
OPENAI_AB_RECOVERY_BATCH_MAX_TOOL_CALLS=2

# On completed-checkpoint continuation, previously researched entities
# are NOT searched again. Only deferred contacts and pending A/B gaps remain.
# The existing costs are restored from SQLite; remaining budget is not reset.

# Strict five-sheet Google Sheets styling reference (sanitized XLSX):
SAT_XLSX_TEMPLATE_PATH=./data/SAT_reference_template.xlsx
# Must point to Python 3 with openpyxl installed; e.g. "python" on Windows.
SAT_PYTHON_BIN=python

# Optional verified public GIR BO revenue before Stage 12 Saby (no paid API).
# Explicit opt-in for existing deployments. The shared request gate serializes
# concurrent studies; each study has its own deadline and request budget.
GIRBO_STAGE_ENABLED=false
GIRBO_STAGE_MAX_COMPANIES=300
GIRBO_STAGE_MAX_MS=900000

# Optional Stage 12 Saby browser collection, OFF on VPS by default.
# Saby uses its own authenticated Playwright profile; no OpenAI web_search.
SABY_STAGE12_ENABLED=false
# Explicit, fail-closed Wasaby tree production gate. OFF by default.
# Requires Stage12 enabled, headed Chromium/Xvfb and independent first-party
# registered INN/KPP identity validation. SABY_MAX_COMPANIES=0 means all
# eligible pending firms, positive integer means that many per run.
# Production processing is sequential within Saby, checkpointed and circuit-broken.
# Its section sweep has no wall-clock deadline.
# Never edit live .env or restart while paid research is running.
SABY_FLEET_TREE_PRODUCTION_ENABLED=false
# Credentials for the same Saby account used at https://online.saby.ru/auth/.
# Fill these values ONLY in your local ignored .env, never in GitHub.
# Leave both empty for manual login; both are required for auto-login.
# Quote values containing '#' or spaces (Node .env syntax).
SABY_LOGIN=
SABY_PASSWORD=
SABY_PROFILE_DIR=./data/saby-profile
SABY_BROWSER_CHANNEL=
SABY_HEADLESS=false
# 0 = all eligible pending companies, without a production time limit.
# Positive integer = an explicit company cap, primarily for rollout/smoke.
# Legacy diagnostic collectors alone use STAGE12_MAX_MS / SABY_ONLY_MAX_MS.
SABY_MAX_COMPANIES=0
# Timeout of a single browser operation remains bounded below.
SABY_COMPANY_TIMEOUT_MS=45000
SABY_DELAY_MS=1500
SABY_CHECKPOINT_EVERY=5
# Renew the browser (not the research) after this many committed section tasks.
SABY_BROWSER_RECYCLE_EVERY=25
SABY_GC_EVERY=10
SABY_CIRCUIT_AFTER=3
# Conservative, OFF by default. Resolve a short-name mismatch ONLY when
# first-party public registration, private detail INN/KPP and stable company
# route independently prove the same legal entity. For ordinary Stage12,
# requires the separate verified fleet production gate above.
SABY_PUBLIC_IDENTITY_FALLBACK_ENABLED=false


# Stage 13 v5: inventory ALL concrete models from sourced research notes,
# A-grade evidence, basis and segment. TORGBOX is not an active source.
# Exact 57-model green/white catalog is fixed. Every OTHER literal model is
# eligible for type classification, EVEN when a buyer already scores 20+.
# Type classification alone is NOT evidence of the buyer's ownership.
# No OpenAI web_search tools; calls count against existing research budget.
STAGE13_AI_ENABLED=true
# Up to 20 sequential requests with 12 unique model labels per request.
# The USD cap below is an ESTIMATE, not a hard provider billing limit.
STAGE13_AI_MAX_CALLS=20
STAGE13_AI_BATCH_SIZE=12
STAGE13_AI_MAX_PER_BUYER=50
STAGE13_AI_MAX_ESTIMATED_USD=0.35
STAGE13_AI_TIMEOUT_MS=25000
STAGE13_AI_MAX_OUTPUT_TOKENS=3500
# Set only if you need to override the existing TARGETED_SEARCH_MODEL:
# STAGE13_AI_MODEL=gpt-5.6-luna
# Saby-only remains browser-only and free unless explicitly enabled:
STAGE13_AI_SABY_ONLY_ENABLED=false
