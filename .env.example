PORT=10000
NODE_ENV=development
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=128000
OPENAI_TARGETED_SEARCH_MAX_OUTPUT_TOKENS=3000
OPENAI_CONTACT_MAX_OUTPUT_TOKENS=1800
MAX_ACTIVE_FULL_JOBS=1
OPENAI_FINAL_BATCH_SIZE=30
OPENAI_FINAL_BATCH_MIN_SPLIT_SIZE=5
OPENAI_FINAL_CONFLICT_GROUP_BATCH_SIZE=12
OPENAI_IDENTITY_MAX_OUTPUT_TOKENS=1800
OPENAI_FINAL_INN_BATCH_SIZE=5
OPENAI_FINAL_INN_CONCURRENCY=4
OPENAI_FINAL_INN_MAX_OUTPUT_TOKENS=2500
OPENAI_ENRICHMENT_CONCURRENCY=8
OPENAI_ENRICHMENT_SEARCH_TIMEOUT_MS=20000
OPENAI_CONTACT_CONCURRENCY=8
OPENAI_CONTACT_SEARCH_TIMEOUT_MS=18000
OPENAI_GOOGLE_FALLBACK_CONCURRENCY=2
OPENAI_CENSUS_ENABLED=true
OPENAI_CENSUS_BUCKET_MIN=12
OPENAI_COVERAGE_GAP_MAX=4
INCLUDE_PUBLIC_OPERATORS=true
STAGE10_MAX_MS=1680000
STAGE11_MAX_MS=1680000
CHECKPOINT_FLUSH_EVERY=10
CHECKPOINT_FLUSH_INTERVAL_MS=10000
COMPUTER_MODEL=gpt-5.6-luna
COMPUTER_FALLBACK_MODEL=gpt-5.6-sol
GOOGLE_AI_MAX_TURNS=2
GOOGLE_AI_AUTO_FALLBACK=false
GOOGLE_AI_COMPANY_TIMEOUT_MS=30000
GOOGLE_AI_VIEWPORT_WIDTH=1024
GOOGLE_AI_VIEWPORT_HEIGHT=768
GOOGLE_AI_SCREENSHOT_DETAIL=low
FINAL_BATCH_MODEL=gpt-5.6-luna
TARGETED_SEARCH_MODEL=gpt-5.6-luna
FINAL_QA_MODEL=gpt-5.6-luna
CONFLICT_MODEL=gpt-5.6-sol
GOOGLE_AI_SOL_RETRY_PRIORITY_AB=false
PLAYWRIGHT_BROWSERS_PATH=0
OPENAI_RESEARCH_MAX_RECOVERY_BRANCHES=1
OPENAI_RESEARCH_GEO_GROUPS=3

# Local persistent storage. Directories are created automatically.
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
LOG_DIR=./logs
PIPELINE_VERSION=1

# Render uses service environment variables instead of this local .env file.
# For the current free Render service keep CHECKPOINT_DB_PATH=/tmp/regionalresearch/checkpoints.sqlite.
OPENAI_WEB_SEARCH_COST_PER_CALL=0.01
