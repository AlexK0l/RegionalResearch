PORT=10000
NODE_ENV=development
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=128000
OPENAI_TARGETED_SEARCH_MAX_OUTPUT_TOKENS=3000
OPENAI_CONTACT_MAX_OUTPUT_TOKENS=1800
MAX_ACTIVE_FULL_JOBS=1
OPENAI_FINAL_BATCH_SIZE=30
OPENAI_FINAL_BATCH_MIN_SPLIT_SIZE=5
OPENAI_FINAL_CONFLICT_GROUP_BATCH_SIZE=12
OPENAI_IDENTITY_MAX_OUTPUT_TOKENS=1800
OPENAI_FINAL_INN_BATCH_SIZE=5
OPENAI_FINAL_INN_CONCURRENCY=4
OPENAI_FINAL_INN_MAX_OUTPUT_TOKENS=2500
OPENAI_ENRICHMENT_CONCURRENCY=8
OPENAI_ENRICHMENT_SEARCH_TIMEOUT_MS=20000
OPENAI_CONTACT_CONCURRENCY=8
OPENAI_CONTACT_SEARCH_TIMEOUT_MS=18000
OPENAI_GOOGLE_FALLBACK_CONCURRENCY=2
OPENAI_CENSUS_ENABLED=true
OPENAI_CENSUS_BUCKET_MIN=12
OPENAI_COVERAGE_GAP_MAX=4
INCLUDE_PUBLIC_OPERATORS=true
STAGE10_MAX_MS=1680000
STAGE11_MAX_MS=1680000
CHECKPOINT_FLUSH_EVERY=10
CHECKPOINT_FLUSH_INTERVAL_MS=10000
COMPUTER_MODEL=gpt-5.6-luna
COMPUTER_FALLBACK_MODEL=gpt-5.6-sol
GOOGLE_AI_MAX_TURNS=2
GOOGLE_AI_AUTO_FALLBACK=false
GOOGLE_AI_COMPANY_TIMEOUT_MS=30000
GOOGLE_AI_VIEWPORT_WIDTH=1024
GOOGLE_AI_VIEWPORT_HEIGHT=768
GOOGLE_AI_SCREENSHOT_DETAIL=low
FINAL_BATCH_MODEL=gpt-5.6-luna
TARGETED_SEARCH_MODEL=gpt-5.6-luna
FINAL_QA_MODEL=gpt-5.6-luna
CONFLICT_MODEL=gpt-5.6-sol
GOOGLE_AI_SOL_RETRY_PRIORITY_AB=false
OPENAI_RESEARCH_MAX_RECOVERY_BRANCHES=1
OPENAI_RESEARCH_GEO_GROUPS=3

# Local persistent storage. Directories are created automatically.
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
LOG_DIR=./logs
PIPELINE_VERSION=1

OPENAI_WEB_SEARCH_COST_PER_CALL=0.01

# Optional when local backend is exposed beyond your own computer
API_ACCESS_TOKEN=
# Max web_search tool calls for a full or resumed research run
OPENAI_FULL_WEB_MAX_CALLS=1850
OPENAI_MAX_RESEARCH_COST_USD=25
OPENAI_ESTIMATE_INPUT_USD_PER_M=0.2
OPENAI_ESTIMATE_CACHED_USD_PER_M=0.02
OPENAI_ESTIMATE_OUTPUT_USD_PER_M=1.2
OPENAI_ENRICHMENT_BATCH_SIZE=4
GOOGLE_AI_FALLBACK_ENABLED=false
OPENAI_PREVIOUS_CONTACT_CACHE=true

# Evidence-first cost controls (local .env; values apply on the next run)
OPENAI_ENRICHMENT_BATCH_MAX_TOOL_CALLS=1
OPENAI_ENRICHMENT_MAX_FALLBACKS_TOTAL=20
OPENAI_ENRICHMENT_MAX_FALLBACKS_PER_BATCH=1


# Local research limits (full/resume). These are independently enforced ceilings
# within OPENAI_FULL_WEB_MAX_CALLS, not an additive quota.
OPENAI_FULL_WEB_DISCOVERY_MAX_CALLS=1050
OPENAI_FULL_WEB_IDENTITY_MAX_CALLS=600
OPENAI_FULL_WEB_ENRICHMENT_MAX_CALLS=190
OPENAI_FULL_WEB_CONTACTS_MAX_CALLS=270
OPENAI_FULL_WEB_STATISTICS_MAX_CALLS=12
OPENAI_FULL_WEB_OTHER_MAX_CALLS=70

# Contact batching and strictly bounded retries
OPENAI_CONTACT_BATCH_ENABLED=true
OPENAI_CONTACT_BATCH_SIZE=5
OPENAI_CONTACT_BATCH_MAX_TOOL_CALLS=2
OPENAI_CONTACT_INDIVIDUAL_FALLBACKS=30
OPENAI_CONTACT_PHONE_RETRIES=12

# IMPORTANT: This template does not overwrite your existing .env file.
# Update the real local .env manually and avoid duplicate variable names.
# The $25 is an *estimated* cost cap, not a confirmed OpenAI billing hard cap.

# Verified A/B gap recovery: deliberately bounded and charged against the
# SAME research $25 / 1850 web calls and 190 enrichment calls (not extra).
OPENAI_AB_RECOVERY_ENABLED=true
OPENAI_AB_RECOVERY_BATCH_SIZE=3
OPENAI_AB_RECOVERY_MAX_BATCHES=20
OPENAI_AB_RECOVERY_BATCH_MAX_TOOL_CALLS=2

# On completed-checkpoint continuation, previously researched entities
# are NOT searched again. Only deferred contacts and pending A/B gaps remain.
# The existing costs are restored from SQLite; remaining budget is not reset.
